# Leave the Twilio values blank to run locally: texts print to the terminal instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111

# Your public web address, e.g. https://stucal.site (used by the Twilio webhook and in texts)
APP_URL=http://localhost:3000
# Shown on the Privacy and Terms pages as the way to contact you
CONTACT_EMAIL=

# Safety cap on login codes sent per hour across the whole app (stops SMS fraud from running up a bill)
MAX_CODES_PER_HOUR=300

PORT=3000
NODE_ENV=development

# Free key from aistudio.google.com: turns on "Add from screenshot"
GEMINI_API_KEY=
